REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sms-phishing-scraper by u/your_username

# Path to tesseract.exe if not on PATH, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Optional: User-Agent for keyless sources (Mastodon, Lemmy, Reddit RSS) and image downloads
HTTP_USER_AGENT=sms-phishing-scraper/0.2 (academic capstone research project)
# Optional: posts fetched per subreddit / hashtag / query each run
SCAN_LIMIT=50
